// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  MASCULINO
  FEMENINO
}

/// Resultado de admisión (equivalente a apto / no apto / condicional-en evaluación).
enum CalificacionAdmision {
  APTO
  NO_APTO
  EN_EVALUACION
}

/// Condición militar del aspirante, para separar el censo.
enum CondicionMilitar {
  SOLDADO_ACTIVO
  SARGENTO_ACTIVO
}

/// Jerarquía del aspirante en el curso (cuadro / roles de servicio).
enum JerarquiaAspirante {
  ASPIRANTE_OFICIAL
  DISTINGUIDO
}

/// Nivel / grado educativo del aspirante (TSU o superior).
enum TipoEstudioAspirante {
  TSU
  PREGRADO
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO
  /// @deprecated Preferir PREGRADO. Se mantiene por filas históricas.
  UNIVERSIDAD
  /// @deprecated Fuera de alcance (solo TSU+). Se mantiene por filas históricas.
  BACHILLER
}

/// Estado civil del aspirante.
enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  UNION_ESTABLE
}

enum ColorCabello {
  NEGRO
  CASTANO_CLARO
  CASTANO_OSCURO
  RUBIO
  ROJIZO
  CANOSO
}

enum FormaLabios {
  VOLUMINOSOS
  FINOS
  GRUESO_EN_EL_CENTRO
  NORMALES
  AUMENTADOS
}

enum FormaNariz {
  PEQUENA
  PERFILADA
  ANCHA
  ARQUEADA
  GRANDE
}

enum ColorOjos {
  CAFE
  AMBAR
  AVELLANA
  VERDE
  AZUL
  GRIS
  NEGRO
}

enum ColorPiel {
  CLARA
  MORENA
  MARRON
  NEGRA
}

enum FactorRh {
  POSITIVO
  NEGATIVO
}

enum SenaParticular {
  LUNARES
  CICATRIZ
  BERRUGA
  MANCHAS_DE_LA_PIEL
  LESIONES
  TATUAJE
  NINGUNA
}

enum TallaUniformePatriota {
  XSS
  SS
  SR
  SL
  MS
  MR
  ML
  LR
  XL
  XLR
  XXL
}

enum TallaUniformeOliva {
  FEM_8_10
  FEM_10_12
  FEM_12_14
  FEM_14_16
  FEM_16_18
  FEM_18_20
  MAS_28_30
  MAS_30_32
  MAS_32_34
  MAS_34_36
  MAS_36_38
  MAS_38_40
}

enum TipoEsquela {
  CUMPLEANOS
  EFEMERIDE
}

/// Motivo institucional del permiso de ausencia del aspirante.
enum TipoPermisoPersonal {
  SALIDA
  PERNOCTA
  FIN_DE_SEMANA
  MEDICO
  COMISION
  FAMILIAR
  OTRO
}

/// Módulo funcional del sistema (agrupa permisos atómicos).
model AuthModule {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  /// Aplicación del portal: `personal` (gestión de personal) o `sistema` (usuarios y auditoría).
  appId       String           @default("personal")
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions AuthPermission[]

  @@index([appId])
}

/// Permiso atómico (clave estable usada en código y sesión).
model AuthPermission {
  id          String               @id @default(cuid())
  key         String               @unique
  label       String
  description String?
  moduleId    String
  module      AuthModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roles       AuthRolePermission[]

  @@index([moduleId])
}

/// Rol asignable a usuarios; los permisos efectivos vienen de la relación N:M.
model AuthRole {
  id          String               @id @default(cuid())
  key         String               @unique
  label       String
  description String?
  /// Rol predefinido del sistema (no se puede eliminar).
  isSystem    Boolean              @default(false)
  /// Puede elegirse al crear o editar usuarios desde la interfaz.
  assignable  Boolean              @default(true)
  /// Acceso total; no se asigna desde la UI.
  isSuper     Boolean              @default(false)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  users       User[]
  permissions AuthRolePermission[]
}

model AuthRolePermission {
  roleId       String
  permissionId String
  role         AuthRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AuthPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  roleId        String
  authRole      AuthRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts              Account[]
  sessions              Session[]
  auditLogs             AuditLog[]

  @@index([roleId])
}

/// Registro de acciones sensibles (censo, convocatorias, exportaciones).
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType])
  @@index([userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Período de ingreso al censo (año y etapa del proceso). Solo una convocatoria está activa para nuevos registros.
model Convocatoria {
  id                   String      @id @default(cuid())
  codigo               String      @unique
  nombre               String
  anio                 Int
  activa               Boolean     @default(false)
  /// Nombre del comandante de la convocatoria / curso.
  comandanteNombre     String?
  /// Teléfono del comandante de la convocatoria / curso.
  comandanteTelefono   String?
  /// Año en que vence el curso. La boleta de permiso imprime «VENCE JULIO {año}».
  anioVence            Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  aspirantes           Aspirante[]
  pelotones            Peloton[]

  @@index([anio])
  @@index([activa])
}

/// Unidad orgánica del curso en una convocatoria. Los aspirantes se asignan a un pelotón.
model Peloton {
  id             String       @id @default(cuid())
  convocatoriaId String
  convocatoria   Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  /// Orden dentro del curso (1, 2, 3…).
  numero         Int
  /// Etiqueta visible (p. ej. «Pelotón 1»).
  nombre         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  aspirantes     Aspirante[]

  @@unique([convocatoriaId, numero])
  @@index([convocatoriaId])
}

model Aspirante {
  id                    String               @id @default(cuid())
  nombres               String
  apellidos             String
  /// La calcula Postgres con fold_busqueda(nombres). No se escribe desde la app.
  nombresBusqueda       String               @default(dbgenerated("fold_busqueda(\"nombres\")"))
  /// La calcula Postgres con fold_busqueda(apellidos). No se escribe desde la app.
  apellidosBusqueda     String               @default(dbgenerated("fold_busqueda(\"apellidos\")"))
  cedula                String
  sexo                  Sexo
  /// Edad se calcula en runtime desde esta fecha (no hay columna `edad`).
  fechaNacimiento       DateTime
  lugarNacimiento       String
  /// Brigada, comando u otra unidad desde la que postula el personal.
  unidadPostulante      String               @default("")
  /// Soldado activo o sargento activo. Null = aún sin clasificar.
  condicionMilitar      CondicionMilitar?
  /// Jerarquía en el curso. Por defecto aspirante a oficial (ASP/OFIC).
  jerarquia             JerarquiaAspirante   @default(ASPIRANTE_OFICIAL)
  calificacionAdmision  CalificacionAdmision @default(EN_EVALUACION)
  direccion             String?
  telefono              String?
  correo                String?
  hijosCantidad         Int                  @default(0)
  estadoCivil           EstadoCivil?
  /// Religión o credo declarado.
  religion              String?
  /// Deporte que practica o le gusta hacer.
  deporte               String?
  /// Usuario, enlace o `NO_POSEE` si declaró no tener esa red.
  instagram             String?
  twitter               String?
  facebook              String?
  /// Ambos padres de nacionalidad venezolana.
  padresVenezolanos     Boolean?
  madreNombres          String?
  madreApellidos        String?
  madreCedula           String?
  madreFechaNacimiento  DateTime?
  padreNombres          String?
  padreApellidos        String?
  padreCedula           String?
  padreFechaNacimiento  DateTime?
  poseeVehiculoPropio   Boolean?
  poseeViviendaPropia   Boolean?
  carnetPatriaSerial    String?
  carnetPatriaCodigo    String?
  /// Cuenta nómina BANFANB.
  cuentaNominaBanfanb   String?
  convocatoriaId        String
  convocatoria          Convocatoria         @relation(fields: [convocatoriaId], references: [id], onDelete: Restrict)
  /// Pelotón del curso al que pertenece el aspirante (misma convocatoria).
  pelotonId             String?
  peloton               Peloton?             @relation(fields: [pelotonId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  datosFisicos          DatosFisicosMedicos?
  contactos             ContactoEmergencia[]
  esquelasGeneradas     Esquela[]
  permisos              PermisoPersonal[]
  asignacionesRolServicio AsignacionRolServicio[]
  /// Revisión de expediente, prueba física y examen médico (estructura versionada; ver `src/lib/aspirantes/ficha-evaluacion.ts`).
  fichaEvaluacion       Json?
  /// Clave del objeto en S3/R2 (p. ej. aspirantes/{id}/foto.webp). Foto tipo carnet.
  fotoKey               String?
  /// Foto impresa en la boleta de permiso (S3/R2). Si falta, se usa `fotoKey`.
  fotoBoletaKey         String?
  /// Foto ceremonial para esquelas (S3/R2). Si falta, se usa `fotoKey`.
  fotoEsquelaKey        String?
  /// Foto de la cédula de identidad (S3/R2).
  fotoCedulaKey         String?
  /// Foto del título universitario / fondo negro (S3/R2).
  fotoTituloKey         String?
  /// Certificado del fondo negro / autenticación del título (S3/R2). Mismo requisito documental.
  fotoTituloAutenticacionKey String?
  /// Notas certificadas (S3/R2): JPEG, PNG o PDF.
  fotoNotasKey String?
  /// Universidad egresado o TSU.
  tipoEstudio              TipoEstudioAspirante?
  /// Nombre de la universidad o instituto.
  nombreUniversidad        String?
  /// Título obtenido (p. ej. Abogada, Ingeniero).
  tituloUniversidad        String?
  /// País donde cursó los estudios.
  paisUniversidad          String?
  /// Núcleo / sede de la universidad.
  nucleoUniversidad        String?
  /// Año de ingreso a la universidad / TSU.
  anioIngresoUniversidad   Int?
  /// Año de egreso de la universidad / TSU.
  anioEgresoUniversidad    Int?
  /// Borrado lógico. Null = visible en el censo. Con fecha = en la papelera.
  deletedAt                DateTime?
  /// Correo de quien lo envió a la papelera.
  deletedByEmail           String?

  @@unique([cedula, convocatoriaId])
  @@index([calificacionAdmision])
  @@index([unidadPostulante])
  @@index([condicionMilitar])
  @@index([jerarquia])
  @@index([pelotonId])
  @@index([deletedAt])
}

/// Permiso de ausencia (salida) de un aspirante, con vigencia de / hasta.
model PermisoPersonal {
  id            String               @id @default(cuid())
  aspiranteId   String
  aspirante     Aspirante            @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  tipo          TipoPermisoPersonal
  fechaInicio   DateTime
  fechaFin      DateTime
  motivo        String
  destino       String?
  autorizadoPor String?
  observaciones String?
  anulado       Boolean              @default(false)
  anuladoMotivo String?
  anuladoAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([aspiranteId, fechaInicio])
  @@index([fechaInicio, fechaFin])
  @@index([anulado])
}

/// Jerarquía de oficiales vinculables a roles de servicio (oficial de día, etc.).
enum JerarquiaAutoridad {
  TENIENTE
  PRIMER_TENIENTE
  CAPITAN
  MAYOR
  TENIENTE_CORONEL
  CORONEL
}

/// Oficial o autoridad del cuadro (no aspirante).
model Autoridad {
  id        String             @id @default(cuid())
  nombres   String
  apellidos String
  cedula    String?
  telefono  String?
  correo    String?
  jerarquia JerarquiaAutoridad
  activa    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  asignacionesRolServicio AsignacionRolServicio[]

  @@index([activa])
  @@index([jerarquia])
}

/// Catálogo de un rol de servicio (enfermería, comedor, cuartelero…).
model RolServicio {
  id        String   @id @default(cuid())
  /// Clave estable, p. ej. `enfermeria-cefoa-46`.
  clave     String   @unique
  nombre    String
  /// Curso de origen, p. ej. `CEFOA 46`.
  curso     String
  sortOrder Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  planes    PlanRolServicio[]
}

/// Publicación mensual de un rol de servicio.
model PlanRolServicio {
  id            String                @id @default(cuid())
  rolServicioId String
  rol           RolServicio           @relation(fields: [rolServicioId], references: [id], onDelete: Cascade)
  anio          Int
  mes           Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  asignaciones  AsignacionRolServicio[]

  @@unique([rolServicioId, anio, mes])
  @@index([anio, mes])
}

/// Persona incluida en el rol de un mes, con los días que le corresponden.
model AsignacionRolServicio {
  id          String          @id @default(cuid())
  planId      String
  plan        PlanRolServicio @relation(fields: [planId], references: [id], onDelete: Cascade)
  orden       Int
  grado       String
  /// Nombre tal como figura en el rol. Puede ir abreviado o vacío.
  nombre      String
  aspiranteId String?
  aspirante   Aspirante?      @relation(fields: [aspiranteId], references: [id], onDelete: SetNull)
  autoridadId String?
  autoridad   Autoridad?      @relation(fields: [autoridadId], references: [id], onDelete: SetNull)
  /// Marcas por día: `[{"dia":8,"marca":"X"}]`.
  dias        Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([planId, orden])
  @@index([aspiranteId])
  @@index([autoridadId])
}

/// Textos fijos de la boleta individual de un permiso. Una sola fila (`formato_permiso`).
model FormatoPermiso {
  id             String   @id
  lineas         String[]
  logoIzq        String   @default("ejercito")
  logoDer        String   @default("cefoa")
  titulo         String   @default("BOLETA DE PERMISO")
  /// Si está vacío, cada boleta usa el pelotón o la unidad del aspirante.
  compania       String   @default("")
  firmanteNombre String   @default("")
  firmanteCargo  String   @default("")
  nota           String   @default("")
  updatedAt      DateTime @updatedAt
}

model ContactoEmergencia {
  id            String   @id @default(cuid())
  nombre        String
  parentesco    String
  telefono      String
  direccion     String?
  aspiranteId   String
  aspirante     Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model DatosFisicosMedicos {
  id                String   @id @default(cuid())
  /// Estatura en metros (el nombre del campo es histórico).
  estaturaCm        Float?
  pesoKg            Float?
  /** Tensión arterial, p. ej. "120/80". */
  tensionArterial   String?
  tipoSangre        String?
  factorRh          FactorRh?
  colorCabello      ColorCabello?
  formaLabios       FormaLabios?
  formaNariz        FormaNariz?
  colorOjos         ColorOjos?
  colorPiel         ColorPiel?
  senaParticular    SenaParticular?
  alergias          String?
  condicionesMedicas String?
  discapacidad      String?
  observaciones     String?
  tallaGorra        String?
  tallaCamisa       String?
  tallaPantalon     String?
  tallaCalzado      String?
  tallaUniformePatriota TallaUniformePatriota?
  tallaUniformeOliva    TallaUniformeOliva?
  aspiranteId       String   @unique
  aspirante         Aspirante @relation(fields: [aspiranteId], references: [id], onDelete: Cascade)
  updatedAt         DateTime @updatedAt
}

/// Encabezado institucional reutilizable en exportaciones (Excel).
model Membrete {
  id        String   @id @default(cuid())
  nombre    String   @unique
  /// Renglones centrados del membrete (máx. 8 en validación de app).
  lineas    String[]
  /// `none` | `cefoa` | `ejercito`
  logoIzq   String   @default("ejercito")
  /// `none` | `cefoa` | `ejercito`
  logoDer   String   @default("cefoa")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

model Efemeride {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  dia         Int
  mes         Int
  tipo        String   @default("NACIONAL")
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  esquelas    Esquela[]

  @@unique([dia, mes, nombre])
}

model Esquela {
  id             String      @id @default(cuid())
  tipo           TipoEsquela
  titulo         String
  cuerpo         String
  fechaEvento    DateTime
  aspiranteId    String?
  efemerideId    String?
  aspirante      Aspirante?  @relation(fields: [aspiranteId], references: [id], onDelete: SetNull)
  efemeride      Efemeride?  @relation(fields: [efemerideId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
}

/// Plantilla visual por tipo de esquela (fondo, corona y recuadros de foto/nombre).
model EsquelaPlantilla {
  id         String       @id @default(cuid())
  tipo       TipoEsquela  @unique
  nombre     String
  /// Clave S3 del fondo; null usa `public/images/esquelas/cumpleanos-plantilla.jpg`.
  fondoKey   String?
  /// Clave S3 de la capa (corona); null usa `public/images/esquelas/corona-laurel.png`.
  overlayKey String?
  layout     Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
